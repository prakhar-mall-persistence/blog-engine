# Copy to .env and fill in. All optional — the engine runs keyless without them.
# .env is gitignored; never commit real keys.

# Automatic post drafting + sharper reasoning (Phase 2 writer)
ANTHROPIC_API_KEY=

# Reliable Google SERP for competitor + AEO citation stages (free 2,500 tier)
SERPER_API_KEY=

# Live answer-engine citation check (asks Perplexity, reads back citations)
PERPLEXITY_API_KEY=

# ── Phase 4: publishing + automation ──────────────────────────────
# Publish path: opens a PR against persistence-dev/website (astro-web). Needs
# a fine-grained token with Contents + Pull requests: write on that repo.
GITHUB_TOKEN=

# Slack approval gate. Bot token path gives interactive Approve/Reject buttons.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#blog-approvals
# …or a simpler incoming webhook (card only, no buttons):
SLACK_WEBHOOK_URL=

# HTTP service (bin/serve.mjs) — how n8n reaches the engine.
PORT=8788
PUBLIC_BASE_URL=http://localhost:8788
ENGINE_BASE_URL=http://localhost:8788

# Email approval notifications. Set ONE provider; recipient is EMAIL_TO.
EMAIL_TO=
EMAIL_FROM=Matrix <blog@persistence.dev>
RESEND_API_KEY=
# …or your own mailer service (e.g. go-mailer):
MAILER_URL=
MAILER_TOKEN=
